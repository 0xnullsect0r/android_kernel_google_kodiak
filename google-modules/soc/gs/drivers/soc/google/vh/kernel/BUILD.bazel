load("//build/kernel/kleaf:kernel.bzl", "ddk_module")

package(
    default_visibility = [
        "//private/devices/google:__subpackages__",
        "//private/google-modules/amplifiers:__subpackages__",
        "//private/google-modules/gpu/mali_kbase:__subpackages__",
        "//private/google-modules/powervr:__subpackages__",
        "//private/google-modules/soc/gs:__subpackages__",
        "//private/google-modules/touch:__subpackages__",
    ],
)

filegroup(
    name = "kconfig",
    srcs = [
        "Kconfig",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
    ],
)

ddk_module(
    name = "systrace",
    out = "systrace.ko",
    conditional_srcs = {
        "CONFIG_VH_SYSTRACE": {
            True: [
                "systrace.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
    ],
)
