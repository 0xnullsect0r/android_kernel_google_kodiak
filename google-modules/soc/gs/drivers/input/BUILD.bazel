# the input core drivers.

load("//build/kernel/kleaf:kernel.bzl", "ddk_module")

package(
    default_visibility = [
        "//private/devices/google:__subpackages__",
        "//private/google-modules/soc/gs:__subpackages__",
    ],
)

filegroup(
    name = "kconfig",
    srcs = [
        "Kconfig",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
    ],
)

ddk_module(
    name = "keycombo",
    out = "keycombo.ko",
    conditional_srcs = {
        "CONFIG_INPUT_KEYCOMBO": {
            True: [
                "keycombo.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
    ],
)

ddk_module(
    name = "keydebug",
    out = "keydebug.ko",
    conditional_srcs = {
        "CONFIG_INPUT_KEYDEBUG": {
            True: [
                "keydebug-core.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    visibility = [
        "//private/devices/google:__subpackages__",
        "//private/google-modules/soc/gs:__subpackages__",
        "//private/google-modules/soc/rdo/drivers/soc/google/debug:__subpackages__",
    ],
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/gs:headers",
        "//private/google-modules/soc/gs/drivers/soc/google:kernel-top",
    ],
)
