load("@kleaf//build/kernel/kleaf:kernel.bzl", "ddk_module")

filegroup(
    name = "lcm-google.kconfig",
    srcs = [
        "Kconfig",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
        "//private/google-modules/soc/rdo:__subpackages__",
    ],
)

ddk_module(
    name = "lcm-google",
    out = "lcm-google.ko",
    conditional_srcs = {
        "CONFIG_GOOGLE_LCM": {
            True: [
                "lcm-google.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    visibility = [
        "//private/google-modules/soc/rdo:__pkg__",
    ],
    deps = [
        "//common:all_headers_aarch64",
        "//private/google-modules/soc/rdo:rdo_soc_headers",
    ],
)
