load("@kleaf//build/kernel/kleaf:kernel.bzl", "checkpatch", "ddk_module", "kernel_module_group")

package(
    default_visibility = [
        "//private/devices/google:__subpackages__",
        "//private/google-modules/soc/rdo:__subpackages__",
    ],
)

checkpatch(
    name = "checkpatch",
    checkpatch_pl = "//common:scripts/checkpatch.pl",
)

ddk_module(
    name = "iis",
    srcs = ["iis.c"],
    out = "iis.ko",
    copts = [
        "-Wall",
        "-Werror",
        '-Dpr_fmt(fmt)=KBUILD_MODNAME ": %s(): " fmt, __func__',
    ],
    kernel_build = "//private/devices/google/common:kernel",
    deps = [
        "//private/google-modules/trusty",
        "//private/google-modules/trusty:trusty_headers",
    ],
)

filegroup(
    name = "iis.kconfig",
    srcs = [
        "Kconfig",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
    ],
)

kernel_module_group(
    name = "iis_group",
    srcs = [
        ":iis",
    ],
)
