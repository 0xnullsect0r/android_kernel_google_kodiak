# Google Battery Management System

load("//build/kernel/kleaf:kernel.bzl", "ddk_headers", "ddk_module", "kernel_module_group")

package(
    default_visibility = [
        "//private/devices/google:__subpackages__",
        "//private/google-modules/aoc/usb:__subpackages__",
        "//private/google-modules/bluetooth:__subpackages__",
        "//private/google-modules/bms:__subpackages__",
        "//private/google-modules/display:__subpackages__",
        "//private/google-modules/misc:__subpackages__",
        "//private/google-modules/power/mitigation:__subpackages__",
        "//private/google-modules/power/reset:__subpackages__",
        "//private/google-modules/radio:__subpackages__",
        "//private/google-modules/soc/gs:__subpackages__",
        "//private/google-modules/soc/rdo:__subpackages__",
    ],
)

filegroup(
    name = "bms-misc.kconfig",
    srcs = [
        "Kconfig",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
    ],
)

ddk_headers(
    name = "headers",
    hdrs = glob([
        "*.h",
    ]),
    includes = ["."],
)

ddk_module(
    name = "gvotable",
    srcs = glob([
        "**/*.h",
    ]),
    out = "gvotable.ko",
    conditional_srcs = {
        "CONFIG_GOOGLE_VOTABLE": {
            True: [
                "gvotable.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = [
        "DYNAMIC_DEBUG_MODULE",
    ],
    deps = [
        "//common:all_headers_aarch64",
    ],
)

ddk_module(
    name = "logbuffer",
    srcs = glob([
        "**/*.h",
    ]),
    out = "logbuffer.ko",
    conditional_srcs = {
        "CONFIG_GOOGLE_LOGBUFFER": {
            True: [
                "logbuffer.c",
            ],
        },
    },
    kernel_build = "//private/devices/google/common:kernel",
    local_defines = [
        "DYNAMIC_DEBUG_MODULE",
    ],
    deps = [
        "//common:all_headers_aarch64",
    ],
)

kernel_module_group(
    name = "bms-misc",
    srcs = [
        ":gvotable",
        ":logbuffer",
    ],
)
